[
  {"id":"to_mp4","section":"Transcode","title":"Anything → MP4 (H.264 + AAC)","description":"Plays everywhere.","original":"ffmpeg -i input.avi -c:v libx264 -c:a aac output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[],"steps":["-i <input> -c:v libx264 -c:a aac <output>"]},
  {"id":"to_webm","section":"Transcode","title":"MP4 → WebM (VP9 + Opus)","description":"For the web. VP9 software encoding is slow on phones.","original":"ffmpeg -i input.mp4 -c:v libvpx-vp9 -b:v 2M -c:a libopus output.webm","outputKind":"FILE","outputExt":"webm","outputMime":"video/webm","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"vbitrate","label":"Video bitrate","default":"2M"}],"steps":["-i <input> -c:v libvpx-vp9 -b:v {vbitrate} -c:a libopus <output>"]},
  {"id":"webm_vpre","section":"Transcode","title":"MP4 → WebM (VP8, libvpx preset)","description":"Uses FFmpeg's bundled libvpx presets: libvpx-360p, libvpx-720p, libvpx-720p50_60, libvpx-1080p, libvpx-1080p50_60. The presets favour quality (cpu-used=0), so encoding is slow.","original":"ffmpeg -i input.mp4 -vpre libvpx-720p -c:a libopus -b:a 128k output.webm","outputKind":"FILE","outputExt":"webm","outputMime":"video/webm","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"preset","label":"Preset","default":"libvpx-720p"},{"key":"abitrate","label":"Audio bitrate","default":"128k"}],"steps":["-i <input> -vpre {preset} -c:a libopus -b:a {abitrate} <output>"]},
  {"id":"remux","section":"Transcode","title":"Remux only (change container)","description":"No re-encoding, no quality loss.","original":"ffmpeg -i input.mkv -c copy output.mp4","outputKind":"FILE","outputExt":"{format}","outputMime":"video/*","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"format","label":"Output container (mp4, mkv, mov…)","default":"mp4"}],"steps":["-i <input> -c copy <output>"]},
  {"id":"crf","section":"Compression & quality","title":"Compress with CRF","description":"CRF 18 = high quality, 28 = small file, 23 = sweet spot.","original":"ffmpeg -i input.mp4 -c:v libx264 -crf 23 -preset medium -c:a aac -b:a 128k output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"crf","label":"CRF (0-51)","default":"23"},{"key":"preset","label":"Preset","default":"medium"},{"key":"abitrate","label":"Audio bitrate","default":"128k"}],"steps":["-i <input> -c:v libx264 -crf {crf} -preset {preset} -c:a aac -b:a {abitrate} <output>"]},
  {"id":"crf_slow","section":"Compression & quality","title":"Compress with slow preset","description":"Slower preset = smaller file at same quality.","original":"ffmpeg -i input.mp4 -c:v libx264 -crf 23 -preset slow output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"crf","label":"CRF (0-51)","default":"23"},{"key":"preset","label":"Preset","default":"slow"}],"steps":["-i <input> -c:v libx264 -crf {crf} -preset {preset} <output>"]},
  {"id":"two_pass","section":"Compression & quality","title":"Two-pass encoding (target bitrate)","description":"Pass 1 analyses (no audio, output discarded), pass 2 hits a target size precisely. Both passes run in sequence.","original":"ffmpeg -y -i input.mp4 -c:v libx264 -b:v 1M -pass 1 -an -f null /dev/null\nffmpeg -i input.mp4 -c:v libx264 -b:v 1M -pass 2 -c:a aac -b:a 128k output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"vbitrate","label":"Video bitrate","default":"1M"},{"key":"abitrate","label":"Audio bitrate","default":"128k"}],"steps":["-y -i <input> -c:v libx264 -b:v {vbitrate} -pass 1 -passlogfile <passlog> -an -f null /dev/null","-i <input> -c:v libx264 -b:v {vbitrate} -pass 2 -passlogfile <passlog> -c:a aac -b:a {abitrate} <output>"]},
  {"id":"audio_mp3","section":"Audio","title":"Extract audio as MP3","description":"-vn = no video, -q:a 2 = high VBR quality.","original":"ffmpeg -i input.mp4 -vn -c:a libmp3lame -q:a 2 audio.mp3","outputKind":"FILE","outputExt":"mp3","outputMime":"audio/mpeg","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"q","label":"VBR quality (0 best - 9 worst)","default":"2"}],"steps":["-i <input> -vn -c:a libmp3lame -q:a {q} <output>"]},
  {"id":"audio_m4a","section":"Audio","title":"Extract audio as M4A (AAC)","description":"","original":"ffmpeg -i input.mp4 -vn -c:a aac -b:a 192k audio.m4a","outputKind":"FILE","outputExt":"m4a","outputMime":"audio/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"abitrate","label":"Audio bitrate","default":"192k"}],"steps":["-i <input> -vn -c:a aac -b:a {abitrate} <output>"]},
  {"id":"audio_copy","section":"Audio","title":"Extract audio without re-encoding","description":"Fastest. The extension must fit the source codec (aac, mp3, opus, ac3…).","original":"ffmpeg -i input.mp4 -vn -c:a copy audio.aac","outputKind":"FILE","outputExt":"{format}","outputMime":"audio/*","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"format","label":"Output extension","default":"aac"}],"steps":["-i <input> -vn -c:a copy <output>"]},
  {"id":"replace_audio","section":"Audio","title":"Replace a video's audio track","description":"","original":"ffmpeg -i video.mp4 -i new_audio.mp3 -c:v copy -c:a aac -map 0:v:0 -map 1:a:0 -shortest output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Video","mime":"video/*","multiple":false},{"key":"audio","label":"New audio","mime":"audio/*","multiple":false}],"params":[],"steps":["-i <input> -i <audio> -c:v copy -c:a aac -map 0:v:0 -map 1:a:0 -shortest <output>"]},
  {"id":"gif","section":"GIF","title":"Video → optimized GIF","description":"Step 1 generates an optimized colour palette, step 2 renders the GIF with it.","original":"ffmpeg -i input.mp4 -vf \"fps=10,scale=480:-1:flags=lanczos,palettegen\" palette.png\nffmpeg -i input.mp4 -i palette.png -filter_complex \"fps=10,scale=480:-1:flags=lanczos[x];[x][1:v]paletteuse\" output.gif","outputKind":"FILE","outputExt":"gif","outputMime":"image/gif","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"fps","label":"Frames per second","default":"10"},{"key":"width","label":"Width (px)","default":"480"}],"steps":["-i <input> -vf \"fps={fps},scale={width}:-1:flags=lanczos,palettegen\" <palette>","-i <input> -i <palette> -filter_complex \"fps={fps},scale={width}:-1:flags=lanczos[x];[x][1:v]paletteuse\" <output>"]},
  {"id":"cut_fast","section":"Cut & join","title":"Fast cut (stream copy)","description":"-ss before -i seeks fast; cuts land on keyframes.","original":"ffmpeg -ss 00:01:30 -i input.mp4 -t 00:00:30 -c copy clip.mp4","outputKind":"FILE","outputExt":"{format}","outputMime":"video/*","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"start","label":"Start","default":"00:01:30"},{"key":"duration","label":"Duration","default":"00:00:30"},{"key":"format","label":"Output container","default":"mp4"}],"steps":["-ss {start} -i <input> -t {duration} -c copy <output>"]},
  {"id":"cut_accurate","section":"Cut & join","title":"Frame-accurate cut (re-encode)","description":"Re-encodes, slower but exact.","original":"ffmpeg -i input.mp4 -ss 00:01:30 -t 00:00:30 -c:v libx264 -c:a aac clip.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"start","label":"Start","default":"00:01:30"},{"key":"duration","label":"Duration","default":"00:00:30"}],"steps":["-i <input> -ss {start} -t {duration} -c:v libx264 -c:a aac <output>"]},
  {"id":"concat","section":"Cut & join","title":"Join videos losslessly","description":"Pick the clips in order. They must share the same codecs. The list file is generated for you.","original":"ffmpeg -f concat -safe 0 -i list.txt -c copy joined.mp4","outputKind":"FILE","outputExt":"{format}","outputMime":"video/*","inputs":[{"key":"videos","label":"Videos (in order)","mime":"video/*","multiple":true}],"params":[{"key":"format","label":"Output container","default":"mp4"}],"steps":["-f concat -safe 0 -i <list> -c copy <output>"]},
  {"id":"scale_exact","section":"Scale, crop, overlay","title":"Scale to exact size","description":"","original":"ffmpeg -i input.mp4 -vf \"scale=1280:720\" -c:a copy output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"width","label":"Width","default":"1280"},{"key":"height","label":"Height","default":"720"}],"steps":["-i <input> -vf \"scale={width}:{height}\" -c:a copy <output>"]},
  {"id":"scale_width","section":"Scale, crop, overlay","title":"Scale by width, keep aspect ratio","description":"-2 = even height (H.264 needs even dimensions).","original":"ffmpeg -i input.mp4 -vf \"scale=640:-2\" output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"width","label":"Width","default":"640"}],"steps":["-i <input> -vf \"scale={width}:-2\" <output>"]},
  {"id":"crop","section":"Scale, crop, overlay","title":"Crop a region","description":"","original":"ffmpeg -i input.mp4 -vf \"crop=640:480:100:50\" output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"w","label":"Width","default":"640"},{"key":"h","label":"Height","default":"480"},{"key":"x","label":"X offset","default":"100"},{"key":"y","label":"Y offset","default":"50"}],"steps":["-i <input> -vf \"crop={w}:{h}:{x}:{y}\" <output>"]},
  {"id":"watermark","section":"Scale, crop, overlay","title":"Watermark (logo overlay)","description":"Default position: top-right corner with a 10px margin.","original":"ffmpeg -i input.mp4 -i logo.png -filter_complex \"overlay=W-w-10:10\" -c:a copy output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false},{"key":"logo","label":"Logo image","mime":"image/*","multiple":false}],"params":[{"key":"pos","label":"Overlay position","default":"W-w-10:10"}],"steps":["-i <input> -i <logo> -filter_complex \"overlay={pos}\" -c:a copy <output>"]},
  {"id":"subtitles","section":"Scale, crop, overlay","title":"Burn subtitles into the video","description":"Uses libass with the system fonts.","original":"ffmpeg -i input.mp4 -vf \"subtitles=subs.srt\" -c:a copy output.mp4","outputKind":"FILE","outputExt":"mp4","outputMime":"video/mp4","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false},{"key":"subs","label":"Subtitle file (.srt/.ass)","mime":"*/*","multiple":false}],"params":[],"steps":["-i <input> -vf \"subtitles=<subs>\" -c:a copy <output>"]},
  {"id":"poster","section":"Frames & streaming","title":"Extract one frame (thumbnail)","description":"","original":"ffmpeg -ss 00:00:05 -i input.mp4 -vframes 1 poster.jpg","outputKind":"FILE","outputExt":"jpg","outputMime":"image/jpeg","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"time","label":"Time","default":"00:00:05"}],"steps":["-ss {time} -i <input> -vframes 1 <output>"]},
  {"id":"frames","section":"Frames & streaming","title":"Dump frames as JPEGs","description":"frame_001.jpg, frame_002.jpg, … Save them to a folder afterwards.","original":"ffmpeg -i input.mp4 -vf fps=1 frame_%03d.jpg","outputKind":"DIRECTORY","outputExt":"","outputMime":"image/jpeg","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"fps","label":"Frames per second","default":"1"}],"steps":["-i <input> -vf fps={fps} <outdir>/frame_%03d.jpg"]},
  {"id":"rtmp","section":"Frames & streaming","title":"Push to an RTMP server","description":"-re = read at native frame rate. Keep the app open while streaming.","original":"ffmpeg -re -i input.mp4 -c:v libx264 -preset veryfast -b:v 2500k -c:a aac -b:a 128k -f flv rtmp://live.example.com/app/STREAM_KEY","outputKind":"NONE","outputExt":"","outputMime":"","inputs":[{"key":"input","label":"Input video","mime":"video/*","multiple":false}],"params":[{"key":"url","label":"RTMP URL","default":"rtmp://live.example.com/app/STREAM_KEY"},{"key":"vbitrate","label":"Video bitrate","default":"2500k"},{"key":"abitrate","label":"Audio bitrate","default":"128k"}],"steps":["-re -i <input> -c:v libx264 -preset veryfast -b:v {vbitrate} -c:a aac -b:a {abitrate} -f flv {url}"]},
