<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.VTLOffmp3g" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/on_green</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">@color/surface_high</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorTertiary">@color/amber</item>
        <item name="colorError">@color/error</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="textInputStyle">@style/Widget.VTLO.TextField</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VTLO.Dialog</item>
    </style>

    <style name="ThemeOverlay.VTLO.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorPrimary">@color/green</item>
    </style>

    <!-- Text -->
    <style name="Text" />
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">32sp</item>
    </style>
    <style name="Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_dim</item>
    </style>
    <style name="Text.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/scope_text</item>
    </style>
    <style name="Text.ScopeLabel" parent="Text.Mono">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/scope_teal</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Cards and controls -->
    <style name="Widget.VTLO.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.VTLO.Button.Pill" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@color/on_green</item>
        <item name="iconTint">@color/on_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
    </style>
    <style name="Widget.VTLO.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_high</item>
        <item name="android:textColor">@color/text</item>
        <item name="iconTint">@color/text</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
    </style>
    <style name="Widget.VTLO.Button.Stop" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/orange</item>
        <item name="android:textColor">@color/orange</item>
        <item name="iconTint">@color/orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
    </style>
    <style name="Widget.VTLO.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/text</item>
    </style>
    <style name="Widget.VTLO.TextField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/surface_high</item>
        <item name="boxStrokeColor">@color/green</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/green</item>
    </style>
    <style name="Widget.VTLO.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/bg</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.VTLO.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/nav_icon</item>
        <item name="itemTextColor">@color/nav_text</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.VTLO.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_container</item>
        <item name="android:width">64dp</item>
        <item name="android:height">36dp</item>
    </style>
</resources>
